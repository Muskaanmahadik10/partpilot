# Copy to .env (git-ignored) and fill in. Never commit real keys.
# offline | anthropic | groq | ollama | openai
PARTPILOT_LLM_PROVIDER=offline
# e.g. claude-haiku-5-5, llama-3.3-70b-versatile, qwen2.5:7b
PARTPILOT_MODEL=
# key for anthropic / groq / openai-compatible providers (not needed for offline or ollama)
PARTPILOT_API_KEY=
# override the endpoint, e.g. http://host.docker.internal:11434/v1 for Ollama on the host from Docker
PARTPILOT_BASE_URL=
# password for all demo accounts (min. 8 characters); empty -> random one printed once at first start
PARTPILOT_DEMO_PASSWORD=
